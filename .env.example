# ========================================================
# InfoTamer (Sloth Agent) Environment Configuration
# ========================================================

# Ollama Host & Local Inference Server URL
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Gemma Model: "gemma2:2b" (Lightweight, fast, 1.6GB)
# Alternative for 16GB+ RAM: "gemma2:9b"
LLM_MODEL=gemma2:2b

# Model generation temperature (0.1 to 0.3 recommended for factual extraction)
LLM_TEMPERATURE=0.2

# Path to local persistent SQLite notification cache
DATABASE_PATH=./data/infotamer.db

# Output directory for daily morning briefs
OUTPUT_DIR=./briefs

# Hours of data retention before automatic purge (Default: 48h)
PURGE_AFTER_HOURS=48

# Comma-separated user identifiers or handles for critical mention tracking
USER_HANDLES=@aryan,aryan,aryan_lead

# Priority alert keywords (comma-separated)
PRIORITY_KEYWORDS=urgent,outage,incident,critical,deploy,deadline,asap,blocked,review,pr

# Overnight scheduled run time (24h format, HH:MM)
SCHEDULED_TIME=06:00
